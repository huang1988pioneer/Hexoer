<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hexoer.ViewModels"
             x:Class="Hexoer.Views.DeployView"
             x:DataType="vm:DeployViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="16" Margin="8" MaxWidth="980">
      <TextBlock Classes="h1" Text="多平台 Pages" />
      <TextBlock Classes="muted" TextWrapping="Wrap"
                 Text="將 Hexo 網站推上 GitHub、GitLab、Codeberg 或 Bitbucket。GitHub 會自動加入 Actions workflow，GitLab 會自動加入 Pages CI；Codeberg、Bitbucket 會使用標準 git push，Pages/CI 請在平台端設定。" />

      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="本機工具" />
          <TextBlock Text="{Binding GitStatus}" />
          <TextBlock Text="{Binding GhStatus}" />
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
            <Button Content="重新整理狀態" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsBusy}" />
            <Button Content="GitHub 登入 (gh auth)" Command="{Binding LoginCommand}" IsEnabled="{Binding !IsBusy}" />
            <Button Content="只加入 workflow 檔" Command="{Binding AddWorkflowOnlyCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card" BorderBrush="#0E7490" BorderThickness="1">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="3">
              <TextBlock Classes="h2" Text="連結既有 Git Repository" />
              <TextBlock Classes="caption" TextWrapping="Wrap"
                         Text="貼上 repository 網址，Hexoer 會辨識 Pages 類型、同步 _config.yml 的 url / root，安全合併遠端內容後部署。" />
            </StackPanel>
            <Border Grid.Column="1" Classes="pill" Padding="10,4" VerticalAlignment="Top">
              <TextBlock Text="推薦" Foreground="#67D8FF" FontWeight="SemiBold" FontSize="12" />
            </Border>
          </Grid>

          <Grid ColumnDefinitions="170,*" ColumnSpacing="8">
            <ComboBox ItemsSource="{Binding RemoteProviders}"
                      SelectedItem="{Binding SelectedRepositoryProvider}"
                      ToolTip.Tip="選擇 Git 平台；各平台會分別保存 Repository URL。" />
            <TextBox Grid.Column="1"
                     Text="{Binding RepositoryUrl}"
                     PlaceholderText="owner/repo 或完整 repository / Pages URL"
                     FontFamily="Consolas, Cascadia Mono, monospace" />
          </Grid>
          <TextBlock Classes="caption" TextWrapping="Wrap"
                     Text="{Binding SelectedRepositoryProvider.Hint}" />

          <Border Background="#101720" BorderBrush="#2A3648" BorderThickness="1"
                  CornerRadius="8" Padding="12">
            <TextBlock Text="{Binding RepositoryTargetSummary}" TextWrapping="Wrap"
                       Classes="muted" LineHeight="20" />
          </Border>

          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="3" VerticalAlignment="Center">
              <CheckBox Content="將 _config.yml 的 url / root 同步為建議 Pages 網址"
                        IsChecked="{Binding SyncRecommendedSiteUrl}" />
              <TextBlock Classes="caption" TextWrapping="Wrap"
                         Text="若遠端已有 README，會先安全取得並保留；遇到衝突立即停止，不會 force push。" />
            </StackPanel>
            <Button Grid.Column="1" Content="連結、推送並啟用 Pages"
                    Classes="accent" Command="{Binding ConnectExistingRepositoryCommand}"
                    IsEnabled="{Binding CanConnectRepository}" Margin="16,0,0,0"
                    VerticalAlignment="Center" />
          </Grid>
        </StackPanel>
      </Border>

      <Grid ColumnDefinitions="*,*" ColumnSpacing="12" MinWidth="0">
        <Border Classes="card" MinWidth="0">
          <StackPanel Spacing="8" MinWidth="0">
            <TextBlock Classes="h2" Text="Repository 連線" />
            <TextBlock Text="{Binding RemoteSummary}" Classes="muted" TextWrapping="WrapWithOverflow" />
          </StackPanel>
        </Border>
        <Border Classes="card" MinWidth="0">
          <StackPanel Spacing="8" MinWidth="0">
            <TextBlock Classes="h2" Text="Pages 狀態" />
            <TextBlock Text="{Binding PagesSummary}" Classes="muted" TextWrapping="WrapWithOverflow" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="查詢 Pages 狀態" Command="{Binding RefreshPagesStatusCommand}"
                      IsEnabled="{Binding !IsBusy}" />
              <Button Content="開啟網站" Command="{Binding OpenPagesUrlCommand}" />
              <Button Content="啟用 Pages (Actions)" Command="{Binding EnablePagesCommand}"
                      IsEnabled="{Binding !IsBusy}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>

      <Border Classes="card deploymentMonitor">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
          <StackPanel Spacing="5" Margin="0,0,20,0">
            <TextBlock Classes="h2" Text="線上版本監控" />
            <TextBlock Text="{Binding DeploymentMonitorTitle}"
                       FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding DeploymentMonitorSummary}"
                       Classes="muted" TextWrapping="Wrap" LineHeight="20" />
            <TextBlock Text="{Binding DeploymentMonitorSchedule}"
                       Classes="caption" TextWrapping="Wrap" />
          </StackPanel>
          <Button Grid.Column="1"
                  Content="立即檢查線上版本"
                  Command="{Binding CheckDeploymentNowCommand}"
                  IsEnabled="{Binding !IsCheckingDeployment}"
                  VerticalAlignment="Center" />
          <ProgressBar Grid.Row="1" Grid.ColumnSpan="2"
                       Margin="0,12,0,0" Height="3"
                       IsIndeterminate="True"
                       IsVisible="{Binding IsCheckingDeployment}" />
        </Grid>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Classes="h2" Text="建立新的 GitHub Repository" />
          <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
            <TextBlock Text="Repo 名稱" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding RepoName}"
                     PlaceholderText="my-hexo-site（只填新 repository 名稱）" />
            <TextBlock Grid.Row="1" Text="可見性" VerticalAlignment="Center" />
            <CheckBox Grid.Row="1" Grid.Column="1" Content="Public repository"
                      IsChecked="{Binding IsPublicRepo}" />
            <TextBlock Grid.Row="2" Text="Commit 訊息" VerticalAlignment="Center" />
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CommitMessage}" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="建立 GitHub Repo + 推送 + 啟用 Pages" Classes="accent"
                    Command="{Binding CreateAndDeployCommand}"
                    IsEnabled="{Binding !IsBusy}" />
            <Button Content="建置、提交並推送更新" Command="{Binding PushCommand}"
                    IsEnabled="{Binding !IsBusy}" />
          </StackPanel>
          <TextBlock Classes="caption" TextWrapping="Wrap"
                     Text="GitHub 流程會寫入 .github/workflows/hexo.yml；GitLab 流程會寫入 .gitlab-ci.yml 並由 Pages CI 發布 public/。Codeberg、Bitbucket 會提交並推送到 origin，請在平台端設定 Pages/CI 或 deploy 分支。" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="進階：hexo-deployer-git（本機 generate 後推 gh-pages）" />
          <TextBlock Classes="caption" TextWrapping="Wrap"
                     Text="舊流程。新站請優先使用上方的 GitHub Actions。若你仍使用 hexo-deployer-git，可在此寫入 _config.yml 的 deploy 區塊。" />
          <Grid ColumnDefinitions="170,*" ColumnSpacing="8">
            <ComboBox ItemsSource="{Binding RemoteProviders}"
                      SelectedItem="{Binding SelectedRepositoryProvider}"
                      ToolTip.Tip="切換平台時，deployer URL 與 branch 也會分別保存。" />
            <TextBox Grid.Column="1" Text="{Binding DeployerRepoUrl}"
                     PlaceholderText="owner/repo 或完整 deploy repository URL" />
          </Grid>
          <TextBlock Classes="caption" TextWrapping="Wrap"
                     Text="此欄位也會依平台分別保存；輸入 owner/repo 時會使用目前選擇的平台。" />
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBox Text="{Binding DeployerBranch}" PlaceholderText="branch（預設 gh-pages）" />
            <Button Grid.Column="1" Content="寫入設定 + 安裝 deployer"
                    Command="{Binding SaveDeployConfigCommand}" IsEnabled="{Binding !IsBusy}" />
            <Button Grid.Column="2" Content="hexo deploy"
                    Command="{Binding DeployWithGitCommand}" IsEnabled="{Binding !IsBusy}" />
          </Grid>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="操作日誌" />
          <TextBox Text="{Binding LogText}"
                   IsReadOnly="True"
                   AcceptsReturn="True"
                   Classes="logBox"
                   MinHeight="160"
                   FontFamily="Consolas, Cascadia Mono, monospace" />
          <TextBlock Text="{Binding StatusMessage}" Classes="muted" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
