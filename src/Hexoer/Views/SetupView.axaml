<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hexoer.ViewModels"
             x:Class="Hexoer.Views.SetupView"
             x:DataType="vm:SetupViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="16" Margin="8">
      <TextBlock Classes="h1" Text="一鍵建立 Hexo 環境" />
      <TextBlock Classes="muted" TextWrapping="Wrap"
                 Text="檢查本機 Node / npm / Git，選擇、初始化，或從 GitHub、GitLab、Codeberg 或 Bitbucket 把既有網站複製到本機。" />

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="專案路徑" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Grid.Column="0" Text="{Binding ProjectPath}" PlaceholderText="Hexo 專案資料夾" />
            <Button Grid.Column="1" Content="瀏覽…" Command="{Binding BrowseProjectCommand}" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Grid.Column="0" Text="{Binding SiteName}" PlaceholderText="網站名稱（初始化用）" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <Button Classes="accent" Content="一鍵建立" Command="{Binding OneClickSetupCommand}"
                      IsEnabled="{Binding !IsBusy}" />
              <Button Content="檢查環境" Command="{Binding CheckEnvironmentCommand}"
                      IsEnabled="{Binding !IsBusy}" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <Border Classes="card" BorderBrush="#0E7490" BorderThickness="1">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="3">
              <TextBlock Classes="h2" Text="從遠端 Git 複製到本機" />
              <TextBlock Classes="caption" TextWrapping="Wrap"
                         Text="本機還沒有網站、但遠端平台已有來源或 Pages 網站時，可貼 repository 或 Pages 網址，複製 Hexo 原始碼後繼續編輯。" />
            </StackPanel>
            <Border Grid.Column="1" Classes="pill" Padding="10,4" VerticalAlignment="Top">
              <TextBlock Text="沒有本機站" Foreground="#67D8FF" FontWeight="SemiBold" FontSize="12" />
            </Border>
          </Grid>

          <TextBox Text="{Binding CloneRepositoryUrl}"
                   PlaceholderText="https://github.com/USER/site、https://gitlab.com/GROUP/site、https://codeberg.org/USER/site、https://bitbucket.org/WORKSPACE/site"
                   FontFamily="Consolas, Cascadia Mono, monospace" />

          <Border Background="#101720" BorderBrush="#2A3648" BorderThickness="1"
                  CornerRadius="8" Padding="12">
            <TextBlock Text="{Binding CloneTargetSummary}" TextWrapping="Wrap"
                       Classes="muted" LineHeight="20" />
          </Border>

          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="偵測我的 GitHub Pages"
                      Command="{Binding DetectGitHubPagesCommand}"
                      IsEnabled="{Binding !IsBusy}" />
              <Button Content="檢查遠端"
                      Command="{Binding InspectRemoteSiteCommand}"
                      IsEnabled="{Binding CanCloneRepository}" />
            </StackPanel>
            <Button Grid.Column="1" Classes="accent" Content="複製到本機"
                    Command="{Binding CloneFromGitHubCommand}"
                    IsEnabled="{Binding CanCloneRepository}"
                    VerticalAlignment="Center" />
          </Grid>
          <TextBlock Classes="caption" TextWrapping="Wrap"
                     Text="複製目標使用上方的專案路徑；尚未選擇時會先請你選資料夾。若該資料夾已有內容，會在同一層或底下建立 repository 同名資料夾。需要 Git；私有 repo 請先完成該平台的 Git 認證。" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="環境狀態" />
          <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
            <TextBlock Grid.Row="0" Grid.Column="0" Classes="muted" Text="Node.js" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding NodeStatus}" />
            <TextBlock Grid.Row="1" Grid.Column="0" Classes="muted" Text="npm" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding NpmStatus}" />
            <TextBlock Grid.Row="2" Grid.Column="0" Classes="muted" Text="Git" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding GitStatus}" />
            <TextBlock Grid.Row="3" Grid.Column="0" Classes="muted" Text="Hexo" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding HexoStatus}" />
            <TextBlock Grid.Row="4" Grid.Column="0" Classes="muted" Text="專案" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ProjectStatus}" TextWrapping="Wrap" />
            <TextBlock Grid.Row="5" Grid.Column="0" Classes="muted" Text="主題" />
            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ThemeStatus}" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <Button Content="npm install" Command="{Binding InstallDependenciesCommand}" IsEnabled="{Binding !IsBusy}" />
            <Button Content="hexo generate" Command="{Binding GenerateCommand}" IsEnabled="{Binding !IsBusy}" />
            <Button Content="hexo clean" Command="{Binding CleanCommand}" IsEnabled="{Binding !IsBusy}" />
          </StackPanel>
          <TextBlock Classes="status" Text="{Binding StatusMessage}" Margin="0,4,0,0" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="Git 與 Pages" />
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="認證交由 Git Credential Manager、SSH 或各平台 CLI 管理；Hexoer 不會儲存 Personal Access Token。" />
          <TextBlock Text="{Binding GitIdentityStatus}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding GitHubStatus}" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Text="{Binding RepositoryUrl}" PlaceholderText="https://github.com/USER/site.git 或 https://gitlab.com/GROUP/site.git" />
            <Button Grid.Column="1" Classes="accent" Content="建立 Git + Pages 工作流 + 推送" Command="{Binding InitializeGitHubCommand}" IsEnabled="{Binding !IsBusy}" />
          </Grid>
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="GitHub 會自動加入 Actions workflow；GitLab、Codeberg、Bitbucket 請在平台端設定 Pages/CI 或 deploy 分支。" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="本機預覽（hexo server）" />
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="啟動本機開發伺服器，於瀏覽器預覽完整 Hexo 站點（預設 http://localhost:4000/）。伺服器會持續執行，直到按「停止」。" />
          <Grid ColumnDefinitions="Auto,80,Auto,Auto,*,Auto" ColumnSpacing="8">
            <TextBlock VerticalAlignment="Center" Text="Port" />
            <TextBox Grid.Column="1" Text="{Binding ServerPort}" />
            <Button Grid.Column="2" Classes="accent" Content="啟動 server"
                    Command="{Binding StartServerCommand}"
                    IsEnabled="{Binding !IsServerRunning}" />
            <Button Grid.Column="3" Content="開啟瀏覽器"
                    Command="{Binding OpenServerInBrowserCommand}"
                    IsEnabled="{Binding IsServerRunning}" />
            <TextBlock Grid.Column="4" Classes="accent-text" VerticalAlignment="Center"
                       Text="{Binding ServerUrl}" IsVisible="{Binding IsServerRunning}" />
            <Button Grid.Column="5" Content="停止"
                    Command="{Binding StopServerCommand}"
                    IsEnabled="{Binding IsServerRunning}"
                    HorizontalAlignment="Right" />
          </Grid>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="執行日誌" />
          <TextBox Text="{Binding LogText}"
                   AcceptsReturn="True"
                   IsReadOnly="True"
                   FontFamily="Consolas,Cascadia Mono,monospace"
                   MinHeight="200"
                   MaxHeight="320"
                   TextWrapping="NoWrap" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
